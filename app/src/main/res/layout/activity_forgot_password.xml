<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Forgot_Password_Activity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        android:layout_margin="16sp"
        android:background="@color/white"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginTop="25sp"
                android:text=" Forgot Password "
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold" />


            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/etFrogotPasswordnName"
                android:hint=" Username/Name"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:inputType="text"
                android:drawableLeft="@drawable/person_icon"
                android:drawablePadding="9dp"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/etFrogotPasswordPassword"
                android:hint="New Password"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:inputType="text"
                android:drawableLeft="@drawable/password_icon"
                android:drawablePadding="9dp"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/etFrogotPasswordnConfirmPassword"
                android:hint=" Confirm Password"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:inputType="text"
                android:drawableLeft="@drawable/password_icon"
                android:drawablePadding="9dp"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/acbtnFrogotPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:text="Frogot Password"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:background="@drawable/button_register"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:backgroundTint="@null"
                android:padding="0dp"
                android:minHeight="0dp"
                android:layout_marginBottom="25sp"
                android:minWidth="0dp" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>