<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".role_selection_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FarmLink"
            android:fontFamily="@font/abril_fatface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#16843A"
            android:layout_marginTop="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose how you want\nto continue"
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="#000000"
            android:layout_marginTop="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cvCustomerCard"
            app:cardCornerRadius="20dp"
            android:elevation="2dp"
            android:padding="15dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp">

         <LinearLayout
            android:id="@+id/customerCard"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
             android:layout_gravity="center"
            android:layout_marginTop="25dp">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/custmor"
                android:paddingLeft="10sp"
                android:contentDescription="Customer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="25dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I'm a Customer"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:id="@+id/tvCustomerCardText"
                    android:textColor="#222222"
                    android:fontFamily="@font/abril_fatface"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shop fresh products\ndirectly from farmers"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp" />



            </LinearLayout>

         </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="35dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cvFarmerCard"
            app:cardCornerRadius="20dp"
            android:elevation="2dp"
            android:padding="15dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp">
        <LinearLayout
        android:id="@+id/farmerCard"
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="15dp"
        android:layout_gravity="center"
        android:layout_marginTop="25dp">

        <ImageView
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:src="@drawable/farmer"
        android:contentDescription="Farmer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/abril_fatface"
                android:text="I'm a Farmer"
                android:id="@+id/tvFarmerCardText"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sell your products to\nthousands of customers"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="5dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="55dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="By continuing, you agree to our"
                android:textSize="11sp"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions and Privacy Policy"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#16843A"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By continuing, you agree to our"
            android:textSize="11sp"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Conditions and Privacy Policy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#16843A"
            android:layout_marginTop="3dp" />


</LinearLayout>

</ScrollView>